{
  "format": 1,
  "name": "range_join_refusals",
  "description": "What range_join refuses and what it lets through: right range values out of order in a bucket some left row has, in a bucket none has, with nulls between, with no left rows at all; range matches that do not parse; missing columns and columns of differing types in the exact and range matches; aggregations other than group, alone, with group, and together with other faults; group inputs that do not exist; group outputs named like left columns or like each other; a range join of a range join.",
  "inputs": [
    {
      "name": "l",
      "columns": [{"name": "Id", "type": "int32"}, {"name": "K", "type": "string"}, {"name": "Lo", "type": "int32"}, {"name": "Hi", "type": "int32"}, {"name": "F", "type": "float64"}],
      "rows": [
        [1, "a", 1, 5, 1.0],
        [2, "a", 3, 3, 2.0],
        [3, "b", 0, 9, 3.0]
      ]
    },
