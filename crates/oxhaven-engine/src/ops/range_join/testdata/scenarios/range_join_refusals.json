      "name": "r_interleaved",
      "columns": [{"name": "K", "type": "string"}, {"name": "P", "type": "int32"}, {"name": "R", "type": "int32"}, {"name": "D", "type": "float64"}, {"name": "N", "type": "int64"}, {"name": "S", "type": "string"}],
      "rows": [
        ["a", 4, 1, 4.0, 4, "4"],
