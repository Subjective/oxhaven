      "rows": [
        ["a", 4, 1, 4.0, 4, "4"],
        ["a", null, 2, null, null, "None"],
        ["a", 5, 3, 5.0, 5, "5"],
        ["b", null, 4, null, null, "None"],
        ["b", 2, 5, 2.0, 2, "2"]
      ]
    },
