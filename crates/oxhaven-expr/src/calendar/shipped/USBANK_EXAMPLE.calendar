<?xml version="1.0" encoding="UTF-8"?>
<!--
  Written for Oxhaven by generate.py in this directory, from the public rules cited
  there. Not derived from Deephaven's calendar files. Licensed as the rest of
  Oxhaven.
  The Federal Reserve Banks' holidays. Those from 1999 to 2012 are before the
  first valid date: no date of those years can be asked for, and holidays()
  lists them, as it does for Deephaven's calendar of this name.
-->
<calendar>
  <name>USBANK_EXAMPLE</name>
  <description>An example calendar of United States bank business days, by the Federal Reserve Banks' holiday schedule; not for trading or other production use.</description>
  <timeZone>America/New_York</timeZone>
  <firstValidDate>2013-01-01</firstValidDate>
  <lastValidDate>2027-12-31</lastValidDate>
  <default>
    <weekend>Saturday</weekend>
    <weekend>Sunday</weekend>
    <businessTime><open>09:00</open><close>17:00</close></businessTime>
  </default>
