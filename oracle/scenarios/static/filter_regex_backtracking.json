 "operations": [
  {
   "name": "doubled",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(\\w+)\\1"
     }
    }
   ]
  },
  {
   "name": "doubled_not",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(.+)\\1",
      "inverted": true
     }
    }
   ]
  },
  {
   "name": "palindrome4",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(.)(.)\\2\\1"
     }
    }
   ]
  },
  {
   "name": "named_year",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?<y>\\d{4})-\\d{2}-\\k<y>"
     }
    }
   ]
  },
  {
   "name": "has_digit",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?=.*\\d).*"
     }
    }
   ]
  },
  {
   "name": "not_foo",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?!foo).*"
     }
    }
   ]
  },
  {
   "name": "not_bar_end",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": ".*(?<!bar)"
     }
    }
   ]
  },
  {
   "name": "after_a",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": ".*(?<=a)b"
     }
    }
   ]
  },
  {
   "name": "possessive",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "a*+b"
     }
    }
   ]
  },
  {
   "name": "possessive_none",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "a*+ab"
     }
    }
   ]
  },
  {
   "name": "atomic",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?>a|ab)c"
     }
    }
   ]
  },
  {
   "name": "atomic_long",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?>ab|a)c"
     }
    }
   ]
  },
  {
   "name": "lookahead_case",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(?=.*B).*",
      "ignore_case": true
     }
    }
   ]
  },
  {
   "name": "lookbehind_case",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "\\w*(?<=H\\w)\\w*",
      "ignore_case": true
     }
    }
   ]
  },
  {
   "name": "group_case",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "((?i)a)\\1"
     }
    }
   ]
  },
  {
   "name": "missing_group",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "(a)\\2|xyx"
     }
    }
   ]
  },
  {
   "name": "line",
   "op": "filter",
   "source": "t",
   "conditions": [
    {
     "matches": {
      "column": "S",
      "text": "a(?=\\n).*"
     }
    }
   ]
  }
 ],
