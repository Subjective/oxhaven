{
  "format": 1,
  "name": "pipeline",
  "description": "A chain: filter, compute, join to a lookup, aggregate, sort, take the top rows.",
  "inputs": [
    {
      "name": "orders",
      "columns": [{"name": "Id", "type": "int32"}, {"name": "Cust", "type": "string"}, {"name": "Qty", "type": "int32"}, {"name": "Price", "type": "float64"}],
      "rows": [
        [1, "ann", 3, 9.99],
        [2, "bob", 1, 120.0],
        [3, "ann", null, 5.0],
        [4, "cy", 10, 0.1],
        [5, "bob", 2, null],
        [6, "dee", 7, 3.3],
        [7, "ann", 1, 0.001],
        [8, null, 4, 2.5],
        [9, "cy", -1, 0.1],
        [10, "eve", 0, 77.0]
      ]
    },
    {
      "name": "customers",
      "columns": [{"name": "Cust", "type": "string"}, {"name": "Region", "type": "string"}],
      "rows": [
        ["ann", "north"],
        ["bob", "south"],
        ["cy", "north"],
        ["dee", null],
        [null, "nowhere"]
      ]
    }
  ],
  "operations": [
    {"name": "valid", "op": "where", "source": "orders", "filters": ["!isNull(Qty)", "Qty >= 0"]},
    {"name": "priced", "op": "update", "source": "valid", "formulas": ["Total = Qty * Price"]},
    {"name": "located", "op": "natural_join", "left": "priced", "right": "customers", "on": ["Cust"], "joins": ["Region"]},
    {"name": "by_region", "op": "agg_by", "source": "located", "aggs": [{"agg": "sum", "columns": ["Total", "Qty"]}, {"agg": "count", "column": "Orders"}, {"agg": "max", "columns": ["Biggest = Total"]}, {"agg": "avg", "columns": ["AvgPrice = Price"]}], "by": ["Region"]},
    {"name": "ranked", "op": "sort", "source": "by_region", "by": [{"column": "Qty", "direction": "descending"}, {"column": "Region", "direction": "ascending"}]},
    {"name": "top", "op": "head", "source": "ranked", "rows": 2},
    {"name": "slim", "op": "drop_columns", "source": "located", "columns": ["Price", "Qty"]}
  ],
  "results": [
    {"table": "valid"},
    {"table": "priced"},
    {"table": "located"},
    {"table": "by_region"},
    {"table": "ranked"},
    {"table": "top"},
    {"table": "slim"}
  ]
}
