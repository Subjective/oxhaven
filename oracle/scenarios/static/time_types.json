{
  "format": 1,
  "name": "time_types",
  "description": "LocalDate, LocalTime, Duration, DayOfWeek and ZonedDateTime columns made by formulas, through sort, match and range filters, join and group keys, select_distinct, and min, max, first, last, count_distinct, unique, median and sorted_first/sorted_last; one instant in several zones, and nulls.",
  "inputs": [
    {
      "name": "t",
      "columns": [{"name": "I", "type": "int32"}, {"name": "T", "type": "timestamp"}],
      "rows": [
        [0, 1710028800000000000],
        [1, 1710075600000000000],
        [2, null],
        [3, 1710169200000000000],
        [4, 1710028800000000000],
        [5, 1710075600000000000],
        [6, 1710122400000000000],
        [7, 1710169200000000000]
      ]
    }
  ],
  "operations": [
    {"name": "base", "op": "update", "source": "t", "formulas": [
      "K = I % 2",
      "D = toLocalDate(T, 'UTC')",
      "LT = toLocalTime(T, 'UTC')",
      "Dur = I == 4 ? null : (I % 3 == 0 ? 'PT1H' : 'PT-2M')",
      "W = dayOfWeek(T, 'UTC')",
      "Z = toZonedDateTime(T, I % 3 == 0 ? 'America/New_York' : (I % 3 == 1 ? 'UTC' : 'Asia/Tokyo'))"
    ]},
    {"name": "sort_d", "op": "sort", "source": "base", "by": [{"column": "D", "direction": "ascending"}]},
    {"name": "sort_lt", "op": "sort", "source": "base", "by": [{"column": "LT", "direction": "descending"}]},
    {"name": "sort_dur", "op": "sort", "source": "base", "by": [{"column": "Dur", "direction": "ascending"}, {"column": "I", "direction": "descending"}]},
    {"name": "sort_w", "op": "sort", "source": "base", "by": [{"column": "W", "direction": "descending"}]},
    {"name": "sort_z", "op": "sort", "source": "base", "by": [{"column": "Z", "direction": "ascending"}]},
    {"name": "sort_z_desc", "op": "sort", "source": "base", "by": [{"column": "Z", "direction": "descending"}]},
    {"name": "where_d", "op": "where", "source": "base", "filters": ["D == '2024-03-10'"]},
    {"name": "where_d_in", "op": "where", "source": "base", "filters": ["D in '2024-03-11', null"]},
    {"name": "where_d_range", "op": "where", "source": "base", "filters": ["D >= '2024-03-11'"]},
    {"name": "where_lt", "op": "where", "source": "base", "filters": ["LT < '13:00'"]},
    {"name": "where_dur", "op": "where", "source": "base", "filters": ["Dur != null"]},
    {"name": "where_w", "op": "where", "source": "base", "filters": ["W in MONDAY"]},
    {"name": "where_w_ne", "op": "where", "source": "base", "filters": ["W != SUNDAY"]},
    {"name": "where_z", "op": "where", "source": "base", "filters": ["Z == '2024-03-10T00:00:00 UTC'"]},
    {"name": "where_z_le", "op": "where", "source": "base", "filters": ["Z <= '2024-03-10T13:00:00 UTC'"]},
    {"name": "where_z_gt", "op": "where", "source": "base", "filters": ["Z > '2024-03-10T08:00:00 Asia/Tokyo'"]},
    {"name": "by_d", "op": "agg_by", "source": "base", "by": ["D"], "aggs": [{"agg": "first", "columns": ["R = I"]}]},
    {"name": "join_d", "op": "natural_join", "left": "base", "right": "by_d", "on": ["D"], "joins": ["R"]},
    {"name": "by_z", "op": "agg_by", "source": "base", "by": ["Z"], "aggs": [{"agg": "last", "columns": ["R = I"]}, {"agg": "count", "column": "N"}]},
    {"name": "join_z", "op": "natural_join", "left": "base", "right": "by_z", "on": ["Z"], "joins": ["R", "N"]},
    {"name": "by_w_first", "op": "agg_by", "source": "base", "by": ["W"], "aggs": [{"agg": "first", "columns": ["R = I"]}]},
    {"name": "join_w", "op": "exact_join", "left": "base", "right": "by_w_first", "on": ["W"], "joins": ["R"]},
    {"name": "by_dur", "op": "agg_by", "source": "base", "by": ["Dur"], "aggs": [{"agg": "last", "columns": ["R = I"]}]},
    {"name": "join_dur", "op": "join", "left": "base", "right": "by_dur", "on": ["Dur"], "joins": ["R"]},
    {"name": "distinct_w_dur", "op": "select_distinct", "source": "base", "columns": ["W", "Dur"]},
    {"name": "values_by_w", "op": "agg_by", "source": "base", "by": ["W"], "aggs": [
      {"agg": "min", "columns": ["MinZ = Z", "MinD = D", "MinLT = LT"]},
      {"agg": "max", "columns": ["MaxZ = Z", "MaxDur = Dur"]},
      {"agg": "first", "columns": ["FirstZ = Z"]},
      {"agg": "last", "columns": ["LastZ = Z"]},
      {"agg": "count_distinct", "columns": ["CdZ = Z"]},
      {"agg": "count_distinct", "columns": ["CdnZ = Z"], "args": {"count_nulls": true}},
      {"agg": "unique", "columns": ["UZ = Z"]},
      {"agg": "median", "columns": ["MedZ = Z"]},
      {"agg": "sorted_first", "columns": ["SfI = I"], "args": {"order_by": "Z"}},
      {"agg": "sorted_last", "columns": ["SlI = I"], "args": {"order_by": "Z"}},
      {"agg": "sorted_first", "columns": ["SfZ = Z"], "args": {"order_by": "I"}}
    ]},
    {"name": "values_by_k", "op": "agg_by", "source": "base", "by": ["K"], "aggs": [
      {"agg": "min", "columns": ["MinZ = Z"]},
      {"agg": "max", "columns": ["MaxZ = Z"]},
      {"agg": "count_distinct", "columns": ["CdZ = Z"]},
      {"agg": "unique", "columns": ["UZ = Z"]},
      {"agg": "sorted_last", "columns": ["SlZ = Z"], "args": {"order_by": "I"}}
    ]},
    {"name": "values_all", "op": "agg_by", "source": "base", "by": [], "aggs": [
      {"agg": "min", "columns": ["MinZ = Z"]},
      {"agg": "max", "columns": ["MaxZ = Z"]},
      {"agg": "count_distinct", "columns": ["CdZ = Z"]}
    ]}
  ],
